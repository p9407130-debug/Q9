#include <stdio.h>
int main(){
    float  P,R,T,SI,CI;
    printf("enter Principle: ");
    scanf("%f",&P);
    printf("enter Rate:");
    scanf("%f",&R);
    printf("Enter Time: ");
    scanf("%f", &T);

    SI = (P * R * T) / 100;
    CI = P * (pow(1 + R / 100, T) - 1);

    printf("Simple Interest = %.2f\n", SI);
    printf("Compound Interest = %.2f\n", CI);

    return 0;
}



